{
	"name": "codesphere",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.6.7",
			"typescript": "^6.0.3",
			"@types/bun": "^1.4.2",
			"varlock": "1.22.0",
			"@orpc/server": "2.0.0-beta.41",
			"@orpc/openapi": "2.0.0-beta.41",
			"@orpc/zod": "2.0.0-beta.41",
			"better-auth": "1.7.14",
			"lucide-react": "^1.41.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.8",
			"react-dom": "^19.2.8",
			"sonner": "^2.0.8",
			"tailwindcss": "^4.3.3",
			"@orpc/client": "2.0.0-beta.41",
			"@orpc/contract": "2.0.0-beta.41",
			"@orpc/tanstack-query": "2.0.0-beta.41",
			"@orpc/json-schema": "2.0.0-beta.41",
			"@orpc/opentelemetry": "2.0.0-beta.41",
			"@orpc/shared": "2.0.0-beta.41",
			"orpc-mcp": "0.1.3",
			"@types/react": "^19.2.18",
			"@types/react-dom": "^19.2.7",
			"drizzle-orm": "1.0.0-rc.4",
			"hono": "^4.13.7",
			"@sentry/bun": "^11.8.0"
		}
	},
	"patchedDependencies": {
		"orpc-mcp@0.1.3": "patches/orpc-mcp@0.1.3.patch"
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"dev:server": "turbo run dev -F server --",
		"db:push": "turbo run db:push -F @codesphere/db --",
		"db:studio": "turbo run db:studio -F @codesphere/db --",
		"db:generate": "turbo run db:generate -F @codesphere/db --",
		"db:migrate": "turbo run db:migrate -F @codesphere/db --",
		"db:seed": "bun run --cwd packages/db db:seed",
		"db:seed:demo": "bun run --cwd packages/api db:seed:demo",
		"e2e": "bun run --cwd apps/e2e e2e",
		"db:local": "turbo run db:local -F @codesphere/db --",
		"db:local:studio": "turbo run db:local:studio -F @codesphere/db --",
		"db:preview:studio": "turbo run db:preview:studio -F @codesphere/db --",
		"db:start": "docker compose up -d postgres",
		"db:watch": "docker compose up postgres",
		"db:stop": "docker compose stop postgres",
		"db:down": "docker compose down postgres",
		"docker:build": "docker compose build",
		"docker:up": "docker compose up -d --build",
		"docker:down": "docker compose down",
		"docker:up:otel": "docker compose -f docker-compose.yml -f docker-compose.otel.yml up -d --build",
		"docker:down:otel": "docker compose -f docker-compose.yml -f docker-compose.otel.yml down",
		"docker:logs": "docker compose logs -f",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"auth:generate": "cd apps/server && bun run auth:generate",
		"licenses": "bun scripts/licenses.mjs",
		"check": "biome check --write ."
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@codesphere/config": "workspace:*",
		"@types/bun": "catalog:",
		"turbo": "^2.10.12",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"packageManager": "bun@1.4.0",
	"volta": {
		"node": "22.21.1"
	},
	"overrides": {
		"@next/env": "npm:@varlock/nextjs-integration@1.2.4",
		"sharp": "npm:empty-npm-package@1.0.0",
		"seroval": "1.6.9",
		"seroval-plugins": "1.6.9",
		"undici": "7.30.1"
	}
}
