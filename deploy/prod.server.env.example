# Template for the PROD_SERVER_ENV secret (becomes apps/server/.env on the server). Never commit the real values.
# Types and rules: apps/server/.env.schema.
NODE_ENV=production
LOG_LEVEL=info
TRUST_PROXY=true

# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://codesphereplatform.xyz
CORS_ORIGIN=https://codesphereplatform.xyz,https://admin.codesphereplatform.xyz

# DATABASE_URL is set by docker-compose.prod.yml from POSTGRES_PASSWORD: do not add it here.

# SSO callbacks: https://codesphereplatform.xyz/api/auth/callback/<github|gitlab|google>
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SUPER_ADMIN_EMAILS=
ADMIN_EMAILS=
MODERATOR_EMAILS=

RESEND_API_KEY=
EMAIL_FROM="CodeSphere Platform <no-reply@codesphereplatform.xyz>"
