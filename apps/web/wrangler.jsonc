{
	"$schema": "node_modules/wrangler/config-schema.json",
	// One Worker serves the web and the API on one origin (#86, #90): cookies stay first-party.
	"name": "codesphere",
	"main": "worker.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
	// workerd resolves pino to its browser build, which ignores `redact` and a custom destination:
	// emails, cookies and tokens would reach Workers Logs in clear. Force the Node build
	// (guarded by packages/logger/src/worker-build.test.ts).
	"alias": { "pino": "pino/pino.js" },
	// Pull request previews: `wrangler preview --name pr-<n>` is served at
	// pr-<n>.preview.codesphereplatform.xyz (previews_enabled creates the wildcard DNS record
	// and certificate).
	// Required by `wrangler preview`, even empty: settings overridden for previews only.
	"previews": {},
	// Every minute the outbox is drained into the queue (#259); every 30 minutes the watch feed also
	// reads its Sources (#255).
	"triggers": { "crons": ["* * * * *", "*/30 * * * *"] },
	// The events of the outbox (#259, docs/outbox.md): this Worker produces and consumes them. Create
	// the queues once: `wrangler queues create codesphere-events` and `codesphere-events-dlq`.
	"queues": {
		"producers": [{ "binding": "EVENTS", "queue": "codesphere-events" }],
		"consumers": [
			{
				"queue": "codesphere-events",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 6,
				"dead_letter_queue": "codesphere-events-dlq"
			}
		]
	},
	"routes": [
		{
			"pattern": "preview.codesphereplatform.xyz",
			"custom_domain": true,
			"previews_enabled": true
		}
	],
	"env": {
		// Staging until the Systalink Cloud Server exists (spec §Environnements): a separate
		// Worker deployed from develop by .github/workflows/staging.yml. Its origin is the only
		// OAuth callback the identity providers know (OAuth proxy, #100).
		"staging": {
			"name": "codesphere-staging",
			"routes": [
				{ "pattern": "staging.codesphereplatform.xyz", "custom_domain": true }
			]
		}
	}
}
