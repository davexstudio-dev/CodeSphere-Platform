# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Empty: the browser calls the API on the host it was loaded from (one origin per host, production).
# @optional @public @type=url
NEXT_PUBLIC_SERVER_URL=

# Shows the "sign in with an email code" field. Must match EMAIL_OTP_SIGNIN on the server.
# @optional @public @type=boolean
NEXT_PUBLIC_EMAIL_OTP_SIGNIN=false

# Whether this deployment has a database. Every deployment has one (each preview gets its own
# Neon branch); `false` keeps the home page from asking the API for data it cannot serve (#157).
# @optional @public @type=boolean
NEXT_PUBLIC_HAS_DATABASE=true

# Serves /design-system, the component reference. `false` answers 404: the production image is
# built with it (apps/web/Dockerfile, docker-compose.prod.yml, production.yml).
# @optional @public @type=boolean
NEXT_PUBLIC_DESIGN_SYSTEM=true
