# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Pino level (#59). JSON lines outside development, pretty in development.
# @public @type=enum(fatal, error, warn, info, debug, trace, silent)
LOG_LEVEL=info

# Read the client IP from x-forwarded-for: only behind a proxy that sets it (Caddy, Cloudflare).
# @public @type=boolean
TRUST_PROXY=false

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# Back-office host in production (admin.<domain>): trusted for auth calls. Unset elsewhere.
# @optional @type=url
ADMIN_ORIGIN=

# Parent domain shared by the public and back-office hosts (e.g. codesphereplatform.xyz).
# Unset elsewhere: the session cookie then stays on the host that set it.
# @optional @type=string(minLength=1)
COOKIE_DOMAIN=

# @type=string(minLength=1)
DATABASE_URL=

# SSO providers are enabled only when both the client id and the secret are set (#63).
# @optional
GITHUB_CLIENT_ID=
# @optional
GITHUB_CLIENT_SECRET=
# @optional
GITLAB_CLIENT_ID=
# @optional
GITLAB_CLIENT_SECRET=
# @optional
GOOGLE_CLIENT_ID=
# @optional
GOOGLE_CLIENT_SECRET=

# OAuth proxy for pull request previews (#100): the identity providers only know the staging
# callback URL. Set both on staging and on every preview, never on production.
# Same secret everywhere: anyone holding it can assert a provider identity.
# @optional @sensitive @type=string(minLength=32)
OAUTH_PROXY_SECRET=

# Origin of the deployment whose callback URL the providers know (the staging origin).
# @optional @type=url
OAUTH_PROXY_PRODUCTION_URL=

# CodeSphere's own social accounts (#265, ADR 0001): an Admin can publish a public Question or
# Hackathon to them. The feature is off unless the identifier, the app password AND the site URL are set.
# Use a Bluesky app password (Settings > Privacy and security > App passwords), never the account password.
# @optional
BLUESKY_SERVICE=https://bsky.social
# @optional
BLUESKY_IDENTIFIER=
# @optional @sensitive
BLUESKY_APP_PASSWORD=

# LinkedIn and X (#266): an Admin connects the official account from the back-office (OAuth),
# and its tokens are stored encrypted and renewed before they expire. Register the application on
# the platform with the redirect URI <PUBLIC_SITE_URL>/admin/social/callback, then set its client id.
# Secret from which the encryption key of the stored tokens is derived (32+ characters, NOT the
# auth secret). Changing it makes the stored accounts unreadable: connect them again.
# @optional @sensitive @type=string(minLength=32)
SOCIAL_CREDENTIALS_SECRET=
# @optional
X_CLIENT_ID=
# Confidential client only; leave empty for a public client.
# @optional @sensitive
X_CLIENT_SECRET=
# @optional
LINKEDIN_CLIENT_ID=
# @optional @sensitive
LINKEDIN_CLIENT_SECRET=
# @optional @type=string
LINKEDIN_API_VERSION=202609
# Post as a Page (urn:li:organization:123) instead of the connected member; the login must administer it.
# @optional
LINKEDIN_AUTHOR=

# Quick trial without OAuth, used only when the client id above is unset. Static tokens are not
# renewed: X's lasts about two hours, LinkedIn's about 60 days.
# @optional @sensitive
LINKEDIN_ACCESS_TOKEN=
# @optional @sensitive
X_ACCESS_TOKEN=
# @optional @type=string
X_USER_ID=

# Public origin of the web app (https://codesphereplatform.xyz): the host of the links that are posted.
# @optional @type=url
PUBLIC_SITE_URL=

# Comma-separated lists of verified emails that receive a staff role (spec §2), highest first:
# super_admin, then admin, then moderator. Staff can use the admin procedures.
# Still sensitive (redacted in logs), but out of varlock's response leak scan: an Admin's own
# address comes back in their session, which the scan would otherwise reject with a 500.
# @optional @sensitive={preventLeaks=false}
SUPER_ADMIN_EMAILS=
# @optional @sensitive={preventLeaks=false}
ADMIN_EMAILS=
# @optional @sensitive={preventLeaks=false}
MODERATOR_EMAILS=

# Reputation needed for each Privilege (#240, decision #219), as a JSON object overriding the
# defaults: {"flag":25,"propose_tag_edit":25,"downvote":75,"close_vote":150,"edit_tags":300}.
# Set only the ones to change, e.g. {"downvote":100}. A malformed value stops the Bun server at start; on a Worker it makes every request fail until fixed.
# @optional @public
PRIVILEGE_THRESHOLDS=

# Moderation of Agent Answers (#245, decision #220), a JSON object overriding the defaults:
# {"rejectScore":-3,"pauseAfter":5,"windowDays":30,"creationBlockAfter":2,"creationBlockDays":30}.
# A malformed value stops the Bun server at start; on a Worker it makes every request fail.
# @optional @public
AGENT_RULES=

# Sign in with a one-time code sent by email, next to SSO. For local development and previews,
# where the SSO providers cannot call back. Keep it off in production.
# @optional @public @type=boolean
EMAIL_OTP_SIGNIN=false

# Transactional email through Resend. Without both values nothing is sent and the API
# carries on: local development and previews need no mail account.
# Resend API key, restricted to "Sending access" and to the sending domain.
# @optional @sensitive @type=string(startsWith=re_)
RESEND_API_KEY=

# Sender on a domain verified in Resend, e.g. "CodeSphere <no-reply@codesphereplatform.xyz>".
# @optional @public
EMAIL_FROM=

# Signing secret of the Resend webhook (#200), "whsec_…" from the Resend dashboard. Resend calls
# POST /webhooks/resend to report emails it accepted but never delivered (bounced, suppressed).
# Without it the endpoint is not mounted. Resend must reach the API: unused on localhost.
# @optional @sensitive @type=string(startsWith=whsec_)
RESEND_WEBHOOK_SECRET=

# Build identity shown by GET /health (spec §5), injected as Docker build args.
# Pre-production builds use main-<short sha>, production the vX.Y.Z tag.
# @public
APP_VERSION=dev

# @public
GIT_SHA=dev

# OpenTelemetry traces are off unless an OTLP/HTTP endpoint is set (e.g. http://localhost:4318)
# @optional @type=url
OTEL_EXPORTER_OTLP_ENDPOINT=

# @optional
OTEL_EXPORTER_OTLP_HEADERS=

# @public @type=string(minLength=1)
OTEL_SERVICE_NAME=codesphere-server

# Sentry error tracking (#253) is off unless a DSN is set. The DSN is write-only for events.
# @optional @type=url
SENTRY_DSN=
