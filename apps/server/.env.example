# Copy to apps/server/.env for local development. Types and rules: .env.schema.
# packages/db reads NODE_ENV and DATABASE_URL from this file too.

NODE_ENV=development
LOG_LEVEL=info
TRUST_PROXY=false

# At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# Postgres from docker-compose.yml (docker compose up postgres)
DATABASE_URL=postgresql://postgres:password@localhost:5432/codesphere

# SSO: a provider is enabled only when both its id and secret are set.
# Local callback: http://localhost:3000/api/auth/callback/<github|gitlab|google>
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Staging and pull request previews only, never local or production (#100).
OAUTH_PROXY_SECRET=
OAUTH_PROXY_PRODUCTION_URL=

# Comma-separated verified emails that get a staff role: super_admin, admin, moderator (highest first)
SUPER_ADMIN_EMAILS=
ADMIN_EMAILS=
MODERATOR_EMAILS=

# Transactional email (Resend). Leave empty locally: nothing is sent.
# RESEND_API_KEY starts with re_ ; EMAIL_FROM is "CodeSphere Platform <no-reply@your-verified-domain>".
RESEND_API_KEY=
EMAIL_FROM=

# Official social accounts (#265): leave empty and the "publish" action is off.
BLUESKY_SERVICE=https://bsky.social
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
PUBLIC_SITE_URL=

APP_VERSION=dev
GIT_SHA=dev

# Traces are off unless set, e.g. http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=codesphere-server
